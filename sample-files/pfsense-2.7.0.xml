<?xml version="1.0"?>
<pfsense>
  <version>22.9</version>
  <lastchange></lastchange>
  <system>
    <optimization>normal</optimization>
    <hostname>edge</hostname>
    <domain>lab.local</domain>
    <timezone>Etc/UTC</timezone>
    <language>en_US</language>
    <user>
      <name>admin</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <bcrypt-hash>$2y$10$YRVoF4SgskIsrXOvOQjGieB9XqHPRra9R7d80B3BZdbY/j21TwBfS</bcrypt-hash>
      <uid>0</uid>
      <priv>page-all</priv>
    </user>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <webgui>
      <protocol>https</protocol>
    </webgui>
    <dnsserver>1.1.1.1</dnsserver>
    <dnsserver>8.8.8.8</dnsserver>
    <timeservers>0.pfsense.pool.ntp.org</timeservers>
  </system>
  <interfaces>
    <wan>
      <enable></enable>
      <if>em0</if>
      <descr>WAN</descr>
      <ipaddr>dhcp</ipaddr>
      <ipaddrv6>dhcp6</ipaddrv6>
      <blockpriv>1</blockpriv>
      <blockbogons>1</blockbogons>
    </wan>
    <lan>
      <enable></enable>
      <if>em1</if>
      <descr>LAN</descr>
      <ipaddr>192.168.1.1</ipaddr>
      <subnet>24</subnet>
    </lan>
  </interfaces>
  <vlans>
    <vlan>
      <if>em1</if>
      <tag>10</tag>
      <vlanif>em1.10</vlanif>
      <descr>VOICE</descr>
    </vlan>
  </vlans>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
    <rule>
      <source>
        <any></any>
      </source>
      <destination>
        <any></any>
      </destination>
      <protocol>tcp</protocol>
      <target>192.168.1.10</target>
      <local-port>443</local-port>
      <interface>wan</interface>
      <descr>HTTPS server</descr>
    </rule>
  </nat>
  <filter>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <statetype>keep state</statetype>
      <protocol>any</protocol>
      <source>
        <network>lan</network>
      </source>
      <destination>
        <any></any>
      </destination>
      <descr>Default allow LAN to any</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>icmp</protocol>
      <icmptype>echoreq</icmptype>
      <source>
        <any></any>
      </source>
      <destination>
        <any></any>
      </destination>
      <descr>Allow WAN ping</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source>
        <any></any>
      </source>
      <destination>
        <address>192.168.1.10</address>
        <port>443</port>
      </destination>
      <descr>NAT HTTPS</descr>
    </rule>
  </filter>
  <aliases>
    <alias>
      <name>Servers</name>
      <type>host</type>
      <address>192.168.1.10 192.168.1.11</address>
      <descr>LAN servers</descr>
    </alias>
  </aliases>
  <dhcpd>
    <lan>
      <enable></enable>
      <range>
        <from>192.168.1.100</from>
        <to>192.168.1.199</to>
      </range>
      <dnsserver>192.168.1.1</dnsserver>
      <staticmap>
        <mac>aa:bb:cc:dd:ee:ff</mac>
        <ipaddr>192.168.1.20</ipaddr>
        <hostname>printer</hostname>
        <descr>Office printer</descr>
      </staticmap>
    </lan>
  </dhcpd>
  <gateways>
    <gateway_item>
      <interface>wan</interface>
      <gateway>dynamic</gateway>
      <name>WAN_DHCP</name>
      <weight>1</weight>
      <ipprotocol>inet</ipprotocol>
      <descr>Interface WAN_DHCP Gateway</descr>
      <monitor_disable></monitor_disable>
      <defaultgw></defaultgw>
    </gateway_item>
  </gateways>
</pfsense>
